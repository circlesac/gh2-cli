{
	"name": "@circlesac/gh2",
	"description": "GitHub App, PAT, Support, and web-only administration operations from the terminal",
	"license": "MIT",
	"type": "module",
	"bin": {
		"gh2": "bin/gh2"
	},
	"files": [
		"bin",
		"skills"
	],
	"scripts": {
		"build": "bun build --compile --outfile=dist/gh2 src/index.ts",
		"dev": "bun run src/index.ts",
		"postinstall": "node bin/install.js",
		"test": "bun run check && vitest run",
		"typecheck": "tsc --noEmit",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"lint": "biome lint .",
		"check": "bun run format:check && bun run lint && bun run typecheck"
	},
	"dependencies": {
		"citty": "^0.2.2"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.6",
		"@types/bun": "^1.4.4",
		"typescript": "^7.0.2",
		"vitest": "^5.1.0"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/circlesac/gh2-cli"
	},
	"version": "0.0.0"
}
